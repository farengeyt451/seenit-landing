---
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.png';

const currentYear = new Date().getFullYear();
---

<Layout>
  <div class="page">
    <header class="header">
      <div class="logo">
        <span class="logo__text">Seenit!</span>
      </div>
      <div class="header__actions">
        <a
          href="https://github.com/farengeyt451/seenit-episode-tracker"
          target="_blank"
          rel="noopener noreferrer"
          class="header__link"
          aria-label="GitHub"
        >
          <GitHubIcon />
        </a>
        <ThemeToggle />
      </div>
    </header>

    <main class="main">
      <section class="hero">
        <h1 class="hero__title">Track your favorite series effortlessly</h1>
        <p class="hero__description">Your personal series companion that lives in your browser</p>
        <div class="hero__wrapper">
          <a
            href="https://chromewebstore.google.com/detail/seenit-episode-tracker/amopmnmnaimidbcfnjbnlfagmlmdhlch"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            >Add to Chrome</a
          >
          <a
            href="https://addons.mozilla.org/ru/firefox/addon/seenit-episode-tracker/"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            >Add to Firefox</a
          >
        </div>
      </section>

      <section class="preview">
        <div class="preview__container">
          <Image
            src={heroImage}
            alt="Seenit! Extension Preview"
            class="preview__image"
            loading="eager"
          />
        </div>
      </section>

      <section class="features">
        <h2 class="features__title">Why Choose Seenit?</h2>
        <div class="features__grid">
          <div class="feature">
            <h3 class="feature__title">Track Episodes Easily</h3>
            <p class="feature__description">
              Mark episodes as watched with a single click. Seenit remembers your progress across all your favorite TV
              shows, so you always know exactly where you left off. No more scrolling through episode lists trying to
              remember what you've already seen.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">Works Offline</h3>
            <p class="feature__description">
              Your viewing history is stored locally in your browser with no data sent to external servers. Your
              privacy is respected, and your information stays on your device where it belongs.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">Clean Interface</h3>
            <p class="feature__description">
              A simple and intuitive design lets you focus on what matters most: enjoying your shows. The extension
              integrates seamlessly with your browsing experience without cluttering your screen or slowing down your
              browser.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">Cross-Browser Support</h3>
            <p class="feature__description">
              Available for both Chrome and Firefox, Seenit works wherever you browse. Install it on your preferred
              browser and start tracking your series right away. Regular updates ensure compatibility with the latest
              browser versions.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">No Account Required</h3>
            <p class="feature__description">
              Start tracking your series immediately without signing up or creating an account. There's no registration
              process, no email verification, and no passwords to remember. Just install the extension and begin using
              it right away.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">No Ads or Tracking</h3>
            <p class="feature__description">
              Enjoy a completely ad-free experience with zero tracking or analytics. Seenit doesn't collect your data,
              monitor your viewing habits, or display advertisements. Your entertainment is yours alone, with no
              interruptions or privacy concerns.
            </p>
          </div>
        </div>
      </section>

      <section class="how-it-works">
        <h2 class="how-it-works__title">How It Works</h2>
        <p class="how-it-works__description">
          Getting started with Seenit is simple. Install the extension from the Chrome Web Store or Firefox Add-ons,
          then click the Seenit icon in your browser toolbar to open the tracker. Add your favorite TV series and start
          marking episodes as you watch them. The extension automatically saves your progress, making it easy to pick up
          where you left off whether you're binge-watching a new series or catching up on weekly episodes.
        </p>
      </section>
    </main>

    <footer class="footer">
      <p class="footer__copyright">©Seenit! - {currentYear}</p>
    </footer>
  </div>
</Layout>
