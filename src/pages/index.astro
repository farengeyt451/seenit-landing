---
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/promo/main.png';
import findImage from '../assets/promo/find.png';
import myseriesImage from '../assets/promo/myseries.png';
import themesImage from '../assets/promo/themes.png';

const currentYear = new Date().getFullYear();

const CHROME_URL =
  'https://chromewebstore.google.com/detail/seenit-episode-tracker/amopmnmnaimidbcfnjbnlfagmlmdhlch';
const FIREFOX_URL = 'https://addons.mozilla.org/firefox/addon/seenit-episode-tracker/';
const GITHUB_URL = 'https://github.com/farengeyt451/seenit-episode-tracker';

const features = [
  {
    title: 'Track Every Episode',
    description:
      "Mark episodes watched or unwatched with a single click. Seenit! remembers your place in every show, so you always know what to watch next.",
  },
  {
    title: 'Visual Progress',
    description:
      'Per-season and per-show progress bars show exactly how far along you are -including ratings, genres and air status at a glance.',
  },
  {
    title: 'Find Any Show',
    description:
      'Smart search lets you look up any TV series and start tracking it in seconds, complete with posters and metadata.',
  },
  {
    title: 'Favorites & Filters',
    description:
      'Star the shows you love for quick access, then filter and sort your library by title or genre to find anything fast.',
  },
  {
    title: 'Cloud Sync with Google Drive',
    description:
      'Optionally back up and sync your watch history to your own Google Drive and pick up right where you left off on any device.',
  },
  {
    title: 'Private by Design',
    description:
      "Local-first by default. Sync uses only Drive's hidden app folder via the minimal drive.appdata scope -no third-party servers, no tracking, no ads.",
  },
];
---

<Layout>
  <div class="page">
    <header class="header">
      <a href="/" class="logo" aria-label="Seenit! home">
        <img src="/icon.png" alt="Seenit! logo" class="logo__mark" width="32" height="32" />
        <span class="logo__text">Seenit!</span>
      </a>
      <div class="header__actions">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="header__link"
          aria-label="GitHub"
        >
          <GitHubIcon />
        </a>
        <ThemeToggle />
      </div>
    </header>

    <main class="main">
      <section class="hero">
        <h1 class="hero__title">Never lose your place in a show again</h1>
        <p class="hero__description">
          Seenit! is a beautiful browser extension that tracks what you've watched and helps you pick
          up right where you left off -across all your favorite series.
        </p>
        <div class="hero__wrapper">
          <a href={CHROME_URL} target="_blank" rel="noopener noreferrer" class="button button--primary">
            Add to Chrome
          </a>
          <a href={FIREFOX_URL} target="_blank" rel="noopener noreferrer" class="button button--secondary">
            Add to Firefox
          </a>
        </div>
      </section>

      <div class="preview">
        <div class="preview__container">
          <Image src={heroImage} alt="Seenit! extension preview" class="preview__image" loading="eager" />
        </div>
      </div>

      <section class="features">
        <h2 class="section-title">Everything you need to keep watching</h2>
        <p class="section-subtitle">
          Powerful tracking wrapped in a clean, distraction-free interface.
        </p>
        <div class="features__grid">
          {
            features.map(feature => (
              <div class="feature">
                <h3 class="feature__title">{feature.title}</h3>
                <p class="feature__description">{feature.description}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="showcase">
        <h2 class="section-title section-title--warm">See it in action</h2>
        <p class="section-subtitle">From finding a new series to binge-tracking your favorites.</p>
        <div class="showcase__grid">
          <figure class="showcase__item">
            <Image src={findImage} alt="Search and find any TV show in Seenit!" class="showcase__image" loading="lazy" />
            <figcaption class="showcase__caption">Find &amp; track any show</figcaption>
          </figure>
          <figure class="showcase__item">
            <Image src={myseriesImage} alt="All your tracked series in one place" class="showcase__image" loading="lazy" />
            <figcaption class="showcase__caption">All your shows in one place</figcaption>
          </figure>
          <figure class="showcase__item showcase__item--wide">
            <Image src={themesImage} alt="Seenit! light and dark themes" class="showcase__image" loading="lazy" />
            <figcaption class="showcase__caption">Gorgeous light &amp; dark themes</figcaption>
          </figure>
        </div>
      </section>

      <section class="sync">
        <div class="sync__inner">
          <div class="sync__content">
            <span class="badge badge--accent">Chrome · Cloud Sync</span>
            <h2 class="section-title sync__title">Your shows, on every device</h2>
            <p class="sync__description">
              Connect your Google Drive to back up your watch history and keep it in sync everywhere.
              A smart conflict-free merge reconciles progress and deletions across devices, so nothing
              is ever lost.
            </p>
          </div>
        </div>
      </section>

      <section class="how-it-works">
        <h2 class="section-title">How it works</h2>
        <p class="how-it-works__description">
          Install the extension, click the Seenit! icon <img
            src="/icon.png"
            alt="Seenit icon"
            class="inline-icon"
            loading="lazy"
          /> in your toolbar, and add the TV series you're watching. Mark episodes as you go - your progress
          is saved automatically, and optionally synced to your Google Drive.
        </p>
      </section>
    </main>

    <footer class="footer">
      <div class="footer__links">
        <a href="/privacy" class="footer__link">Privacy Policy</a>
        <span class="footer__sep">·</span>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="footer__link">GitHub</a>
        <span class="footer__sep">·</span>
        <a href={CHROME_URL} target="_blank" rel="noopener noreferrer" class="footer__link">Chrome</a>
        <span class="footer__sep">·</span>
        <a href={FIREFOX_URL} target="_blank" rel="noopener noreferrer" class="footer__link">Firefox</a>
      </div>
      <p class="footer__copyright">© Seenit! - {currentYear}</p>
    </footer>
  </div>
</Layout>

<style>
  .badge {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    color: var(--text-secondary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
  }

  .badge--accent {
    color: #fff;
    background: linear-gradient(90deg, var(--gradient-blue), var(--gradient-purple));
    border: none;
  }

  /* Section headings */
  .section-title {
    font-family: 'Poppins', system-ui, sans-serif;
    font-size: 2.5rem;
    text-align: center;
    margin-bottom: 0.75rem;
    background: linear-gradient(90deg, var(--gradient-blue), var(--gradient-purple), var(--gradient-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-title--warm {
    background: linear-gradient(90deg, #f59e0b, #f97316, #ef4444);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-subtitle {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  /* Secondary button */
  .button--secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .button--secondary:hover {
    transform: translateY(-2px);
    border-color: var(--accent-blue);
    color: var(--accent-blue);
  }

  /* Logo */
  .logo {
    text-decoration: none;
  }

  .logo__mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: block;
  }

  /* Showcase */
  .showcase {
    padding: 4rem 2rem;
    background-color: var(--bg-primary);
  }

  .showcase__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .showcase__item {
    margin: 0;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .showcase__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .showcase__item--wide {
    grid-column: 1 / -1;
  }

  .showcase__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .showcase__caption {
    padding: 1rem 1.25rem;
    font-family: 'Poppins', system-ui, sans-serif;
    font-weight: 600;
    color: var(--text-primary);
    text-align: center;
  }

  /* Cloud Sync section */
  .sync {
    padding: 4rem 2rem;
    background-color: var(--bg-secondary);
  }

  .sync__inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .sync__title {
    margin-top: 1rem;
  }

  .sync__description {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 680px;
    margin: 0 auto;
  }

  /* Footer links */
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .footer__link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: var(--accent-blue);
  }

  .footer__sep {
    color: var(--text-tertiary);
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }

    .showcase__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .showcase,
    .sync {
      padding: 3rem 1.5rem;
    }

    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
