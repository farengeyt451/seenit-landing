---
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import LinkedInIcon from '../components/icons/LinkedInIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

const currentYear = new Date().getFullYear();

const CHROME_URL =
  'https://chromewebstore.google.com/detail/seenit-episode-tracker/amopmnmnaimidbcfnjbnlfagmlmdhlch';
const FIREFOX_URL = 'https://addons.mozilla.org/ru/firefox/addon/seenit-episode-tracker/';
const GITHUB_URL = 'https://github.com/farengeyt451/seenit-episode-tracker';
const LINKEDIN_URL = 'https://www.linkedin.com/in/alexander-kislov/';

const features = [
  {
    title: 'Track every episode',
    description:
      'One click marks an episode watched. Per-season progress bars remember exactly where you left off across every show.',
  },
  {
    title: 'Rich series overview',
    description:
      'See the poster, rating, genres and a live air-status badge that keeps pinging while a show is still running.',
  },
  {
    title: 'Find & organize',
    description:
      'Search to add any show, then filter, sort, favorite and drag to reorder your list exactly how you like it.',
  },
  {
    title: 'Cloud sync, optional',
    description:
      'Connect Google Drive on Chrome to back up and sync progress across devices. Conflict-free merging keeps everything in step.',
  },
  {
    title: 'Private & local-first',
    description:
      'Your data lives in your browser by default. No account, no ads, no tracking - and you can export or import it anytime.',
  },
  {
    title: 'Dark & light themes',
    description:
      'A clean, fast interface that looks great day or night, kept up to date on both Chrome and Firefox.',
  },
];

const steps = [
  {
    number: '1',
    title: 'Install & pin',
    description: 'Add Seenit! to Chrome or Firefox and pin the icon to your toolbar.',
  },
  {
    number: '2',
    title: 'Add your shows',
    description: 'Search by title and add the series you are watching. Metadata is powered by TheTVDB.',
  },
  {
    number: '3',
    title: 'Mark as you watch',
    description: 'Tap episodes as you finish them. Progress saves automatically - and syncs, if you want it to.',
  },
];

const faqs = [
  {
    question: 'What is Seenit!?',
    answer:
      'Seenit! is a free browser extension and TV companion that tracks which episodes of a series you have watched, so you always know what to watch next.',
  },
  {
    question: 'Is Seenit! free?',
    answer: 'Yes. Seenit! is completely free, with no account required, no ads and no tracking.',
  },
  {
    question: 'Which browsers does Seenit! support?',
    answer: 'Seenit! is available as an extension for Google Chrome and as an add-on for Mozilla Firefox.',
  },
  {
    question: 'What does the Chrome Web Store Featured badge mean?',
    answer:
      'The Featured badge is awarded by Google to extensions that follow technical best practices, respect user privacy, and deliver a great user experience. Seenit! earned it - so you can install with confidence.',
  },
  {
    question: 'Does Seenit! sync across devices?',
    answer:
      'Optionally. On Chrome you can connect your own Google Drive to back up and sync your watch history across devices. Sync is off by default and Seenit! works fully offline.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const syncPoints = [
  {
    title: 'Backup in your own Drive',
    description: 'Your watch history is stored in your personal Google Drive - not on our servers. You stay in control.',
  },
  {
    title: 'Sync across devices',
    description: 'Mark an episode on your laptop and see it on your desktop. Progress follows you everywhere you sign in.',
  },
  {
    title: 'Conflict-free merging',
    description: 'Watched on two machines while offline? Changes merge cleanly so nothing gets lost or overwritten.',
  },
  {
    title: 'Opt-in and reversible',
    description: 'Sync is off until you connect it, and you can disconnect at any time. Local-first stays the default.',
  },
];

// Themed parallax icons for the hero (scene). Each item is a "layer" with a
// data-depth (mouse sensitivity) and data-scroll (scroll sensitivity).
const parallaxIcons = {
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>',
  play: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>',
  star: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.6 1.6 6.8L12 17.8 5.8 20.9l1.6-6.8L2.2 8.9l6.9-.6z"/></svg>',
  square: '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="4"/></svg>',
  eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>',
  bookmark: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h12a2 2 0 0 1 2 2v18l-8-4-8 4V4a2 2 0 0 1 2-2z"/></svg>',
};

const parallaxItems = [
  // Above the content
  { icon: 'check', pos: 'top: 6%; left: 40%;', depth: 0.35, scroll: 0.05, size: 24, rot: -12, tone: 'green' },
  { icon: 'square', pos: 'top: 9%; left: 60%;', depth: 0.2, scroll: 0.03, size: 16, rot: 18, tone: 'purple' },
  // Left flank, hugging the content
  { icon: 'star', pos: 'top: 23%; left: 23%;', depth: 0.3, scroll: 0.05, size: 18, rot: 10, tone: 'pink' },
  { icon: 'play', pos: 'top: 42%; left: 25%;', depth: 0.28, scroll: 0.05, size: 22, rot: -8, tone: 'blue' },
  { icon: 'eye', pos: 'top: 60%; left: 22%;', depth: 0.34, scroll: 0.06, size: 22, rot: 8, tone: 'blue' },
  { icon: 'check', pos: 'top: 76%; left: 28%;', depth: 0.24, scroll: 0.04, size: 20, rot: -14, tone: 'green' },
  // Right flank, hugging the content
  { icon: 'play', pos: 'top: 21%; left: 77%;', depth: 0.36, scroll: 0.05, size: 22, rot: 12, tone: 'blue' },
  { icon: 'bookmark', pos: 'top: 39%; left: 75%;', depth: 0.26, scroll: 0.04, size: 20, rot: -12, tone: 'pink' },
  { icon: 'star', pos: 'top: 57%; left: 79%;', depth: 0.3, scroll: 0.05, size: 18, rot: 9, tone: 'pink' },
  { icon: 'check', pos: 'top: 73%; left: 74%;', depth: 0.4, scroll: 0.06, size: 26, rot: -10, tone: 'green' },
  // Below the content
  { icon: 'square', pos: 'top: 90%; left: 43%;', depth: 0.22, scroll: 0.03, size: 16, rot: 16, tone: 'purple' },
  { icon: 'star', pos: 'top: 88%; left: 60%;', depth: 0.24, scroll: 0.05, size: 18, rot: -18, tone: 'pink' },
];
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <div class="page">
    <header class="header">
      <a href="/" class="logo" aria-label="Seenit! home">
        <img src="/icon-128.png" alt="Seenit! logo" class="logo__mark" width="32" height="32" />
        <span class="logo__text">Seenit!</span>
      </a>
      <div class="header__actions">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="header__link"
          aria-label="GitHub"
        >
          <GitHubIcon />
        </a>
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="header__link"
          aria-label="LinkedIn"
        >
          <LinkedInIcon />
        </a>
        <ThemeToggle />
      </div>
    </header>

    <main class="main">
      <section class="hero" data-parallax-scene>
        <div class="parallax" aria-hidden="true">
          {
            parallaxItems.map((item) => (
              <span
                class="parallax__item"
                data-depth={item.depth}
                data-scroll={item.scroll}
                style={item.pos}
              >
                <span
                  class={`parallax__inner parallax__inner--${item.tone}`}
                  style={`width: ${item.size}px; height: ${item.size}px; --rot: ${item.rot}deg;`}
                  set:html={parallaxIcons[item.icon as keyof typeof parallaxIcons]}
                />
              </span>
            ))
          }
        </div>
        <span class="hero__badge">
          <span class="hero__badge-medal" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path
                d="M20 10c0-4.42-3.58-8-8-8s-8 3.58-8 8c0 2.03.76 3.87 2 5.28V23l6-2 6 2v-7.72c1.24-1.41 2-3.25 2-5.28zm-8-6c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6 2.69-6 6-6zm0 15-4 1.02v-3.1c1.18.68 2.54 1.08 4 1.08s2.82-.4 4-1.08v3.1L12 19zm-3-9c0-1.66 1.34-3 3-3s3 1.34 3 3-1.34 3-3 3-3-1.34-3-3z"
              ></path>
            </svg>
          </span>
          <span class="hero__badge-text"><strong>Featured</strong> on the Chrome Web Store</span
          >
        </span>
        <h1 class="hero__title">Your shows, perfectly tracked</h1>
        <p class="hero__description">
          Mark what you've watched, see every series at a glance, and pick up right where you left off.
          A private, free, local-first episode tracker and TV companion that lives in your browser
        </p>
        <div class="hero__wrapper">
          <a href={CHROME_URL} target="_blank" rel="noopener noreferrer" class="button button--primary"
            >Add to Chrome</a
          >
          <a href={FIREFOX_URL} target="_blank" rel="noopener noreferrer" class="button button--secondary"
            >Add to Firefox</a
          >
        </div>
      </section>

      <div class="preview">
        <div class="preview__container">
          <div class="preview__stage">
            <img
              src="/light.png"
              alt="Seenit! extension in light mode"
              class="preview__popup preview__popup--light"
              width="479"
              height="600"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <img
              src="/dark.png"
              alt="Seenit! extension in dark mode"
              class="preview__popup preview__popup--dark"
              width="479"
              height="600"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <section class="features" id="features">
        <h2 class="features__title">Everything you need to keep up</h2>
        <div class="features__grid">
          {
            features.map((feature) => (
              <div class="feature">
                <h3 class="feature__title">{feature.title}</h3>
                <p class="feature__description">{feature.description}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="steps">
        <h2 class="steps__title">Up and running in seconds</h2>
        <div class="steps__grid">
          {
            steps.map((step) => (
              <div class="step">
                <span class="step__number">{step.number}</span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__description">{step.description}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sync" id="sync">
        <div class="sync__inner">
          <div class="sync__content">
            <span class="sync__badge">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
                <path
                  d="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A5.994 5.994 0 0 0 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"
                ></path>
              </svg>
              Cloud sync · Chrome
            </span>
            <h2 class="sync__title">Google&nbsp;Drive sync, on your terms</h2>
            <p class="sync__description">
              Connect your Google account on Chrome to back up your library and keep every device in step.
              It is completely optional - Seenit! works fully offline without it.
            </p>
            <ul class="sync__list">
              {
                syncPoints.map((point) => (
                  <li class="sync__item">
                    <span class="sync__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </span>
                    <span class="sync__item-text">
                      <strong class="sync__item-title">{point.title}</strong>
                      <span class="sync__item-desc">{point.description}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="sync__visual" aria-hidden="true">
            <div class="sync__card sync__card--device">
              <span class="sync__card-label">This device</span>
              <span class="sync__card-status sync__card-status--ok"
                ><span class="sync__card-dot"></span>In sync</span
              >
            </div>
            <div class="sync__drive">
              <span class="sync__drive-icon">
                <svg viewBox="0 0 87.3 78" width="48" height="48" aria-hidden="true">
                  <path d="m6.6 66.85 3.85 6.65c.8 1.4 1.95 2.5 3.3 3.3l13.75-23.8h-27.5c0 1.55.4 3.1 1.2 4.5z" fill="#0066da"/>
                  <path d="m43.65 25-13.75-23.8c-1.35.8-2.5 1.9-3.3 3.3l-25.4 44a9.06 9.06 0 0 0 -1.2 4.5h27.5z" fill="#00ac47"/>
                  <path d="m73.55 76.8c1.35-.8 2.5-1.9 3.3-3.3l1.6-2.75 7.65-13.25c.8-1.4 1.2-2.95 1.2-4.5h-27.502l5.852 11.5z" fill="#ea4335"/>
                  <path d="m43.65 25 13.75-23.8c-1.35-.8-2.9-1.2-4.5-1.2h-18.5c-1.6 0-3.15.45-4.5 1.2z" fill="#00832d"/>
                  <path d="m59.8 53h-32.3l-13.75 23.8c1.35.8 2.9 1.2 4.5 1.2h50.8c1.6 0 3.15-.45 4.5-1.2z" fill="#2684fc"/>
                  <path d="m73.4 26.5-12.7-22c-.8-1.4-1.95-2.5-3.3-3.3l-13.75 23.8 16.15 28h27.45c0-1.55-.4-3.1-1.2-4.5z" fill="#ffba00"/>
                </svg>
              </span>
              <span class="sync__drive-label">Google Drive</span>
              <span class="sync__drive-sub">Your backup</span>
            </div>
            <div class="sync__card sync__card--device">
              <span class="sync__card-label">Other device</span>
              <span class="sync__card-status sync__card-status--ok"
                ><span class="sync__card-dot"></span>In sync</span
              >
            </div>
          </div>
        </div>
      </section>

      <section class="faq" id="faq">
        <h2 class="faq__title">Frequently asked questions</h2>
        <div class="faq__grid">
          {
            faqs.map((faq) => (
              <details class="faq__item">
                <summary class="faq__question">{faq.question}</summary>
                <p class="faq__answer">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

    </main>

    <footer class="footer">
      <div class="footer__links">
        <a href="/privacy" class="footer__link">Privacy Policy</a>
        <span class="footer__sep">·</span>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="footer__link">GitHub</a>
        <span class="footer__sep">·</span>
        <a
          href="https://www.linkedin.com/in/alexander-kislov/"
          target="_blank"
          rel="noopener noreferrer"
          class="footer__link">LinkedIn</a
        >
      </div>
      <p class="footer__copyright">© Seenit! - {currentYear}</p>
    </footer>
  </div>

  <script>
    const scene = document.querySelector<HTMLElement>('[data-parallax-scene]');
    const items = scene
      ? Array.from(scene.querySelectorAll<HTMLElement>('.parallax__item'))
      : [];
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (scene && items.length && !prefersReduced) {
      const MAX_SHIFT = 45; // px of travel at depth 1 for full cursor swing
      const FRICTION = 0.08; // easing toward the target (like parallax.js friction)

      let targetX = 0;
      let targetY = 0;
      let curX = 0;
      let curY = 0;
      let scrollY = window.scrollY;
      let running = false;

      const render = () => {
        curX += (targetX - curX) * FRICTION;
        curY += (targetY - curY) * FRICTION;

        for (const el of items) {
          const depth = parseFloat(el.dataset.depth || '0');
          const scrollDepth = parseFloat(el.dataset.scroll || '0');
          // Inverted input: layers move opposite to the cursor.
          const mx = -curX * depth * MAX_SHIFT;
          const my = -curY * depth * MAX_SHIFT;
          const sy = scrollY * scrollDepth;
          el.style.transform = `translate3d(${mx.toFixed(2)}px, ${(my + sy).toFixed(2)}px, 0)`;
        }

        // Keep animating while the cursor is still settling or we keep scrolling.
        if (Math.abs(targetX - curX) > 0.0005 || Math.abs(targetY - curY) > 0.0005) {
          requestAnimationFrame(render);
        } else {
          running = false;
        }
      };

      const kick = () => {
        if (!running) {
          running = true;
          requestAnimationFrame(render);
        }
      };

      window.addEventListener(
        'pointermove',
        (e) => {
          const cx = window.innerWidth / 2;
          const cy = window.innerHeight / 2;
          targetX = (e.clientX - cx) / cx; // -1 .. 1
          targetY = (e.clientY - cy) / cy; // -1 .. 1
          kick();
        },
        { passive: true }
      );

      window.addEventListener(
        'scroll',
        () => {
          scrollY = window.scrollY;
          kick();
        },
        { passive: true }
      );

      render();
    }
  </script>
</Layout>

<style>
  /* Parallax scene (hero only) */
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero > *:not(.parallax) {
    position: relative;
    z-index: 1;
  }

  .parallax {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .parallax__item {
    position: absolute;
    will-change: transform;
  }

  .parallax__inner {
    display: block;
    opacity: 0.6;
    transform: rotate(var(--rot, 0deg));
    animation: pxFloat 7s ease-in-out infinite alternate;
  }

  .parallax__inner :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .parallax__inner--green {
    color: #22c55e;
  }
  .parallax__inner--blue {
    color: var(--gradient-blue);
  }
  .parallax__inner--purple {
    color: var(--gradient-purple);
  }
  .parallax__inner--pink {
    color: var(--gradient-pink);
  }

  body.light-theme .parallax__inner {
    opacity: 0.5;
  }

  .parallax__item:nth-child(odd) .parallax__inner {
    animation-duration: 8.5s;
  }
  .parallax__item:nth-child(3n) .parallax__inner {
    animation-duration: 9.5s;
    animation-delay: -3s;
  }
  .parallax__item:nth-child(4n) .parallax__inner {
    animation-duration: 6.5s;
    animation-delay: -1.5s;
  }
  .parallax__item:nth-child(5n) .parallax__inner {
    animation-duration: 10.5s;
    animation-delay: -4.5s;
  }

  @keyframes pxFloat {
    from {
      transform: rotate(calc(var(--rot, 0deg) - 4deg)) translateY(0);
    }
    to {
      transform: rotate(calc(var(--rot, 0deg) + 4deg)) translateY(-8px);
    }
  }

  @media (max-width: 768px) {
    .parallax {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax__inner {
      animation: none;
    }
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.1rem 0.4rem 0.4rem;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-secondary);
    border: 1px solid transparent;
    background:
      linear-gradient(var(--bg-secondary), var(--bg-secondary)) padding-box,
      linear-gradient(120deg, #34a853, var(--gradient-blue), var(--gradient-purple)) border-box;
    box-shadow: 0 6px 20px rgba(52, 168, 83, 0.14);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .hero__badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgba(52, 168, 83, 0.22);
  }

  .hero__badge-medal {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, #34a853, #1e8e3e);
    box-shadow: 0 3px 10px rgba(52, 168, 83, 0.45);
  }

  .hero__badge-medal::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.5);
    animation: badgePulse 2.6s ease-out infinite;
  }

  @keyframes badgePulse {
    0% {
      box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.45);
    }
    70% {
      box-shadow: 0 0 0 9px rgba(52, 168, 83, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(52, 168, 83, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__badge-medal::before {
      animation: none;
    }
  }

  .hero__badge-text strong {
    font-weight: 700;
    color: var(--text-primary);
  }

  .button--secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  body.dark-theme .button--secondary {
    border-color: rgba(255, 255, 255, 0.1);
  }

  body.light-theme .button--secondary {
    background-color: var(--bg-secondary);
    border-color: #cbd5e1;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }

  .button--secondary:hover {
    color: var(--text-primary);
    transform: translateY(-2px);
    border-color: var(--accent-blue);
  }

  .hero__note {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }

  body.light-theme .hero__note {
    color: var(--text-secondary);
  }

  /* Steps */
  .steps {
    padding: 4rem 2rem;
    background-color: var(--bg-primary);
