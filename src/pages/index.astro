---
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.png';

const currentYear = new Date().getFullYear();
---

<Layout>
  <div class="page">
    <header class="header">
      <div class="logo">
        <span class="logo__text">Seenit!</span>
      </div>
      <div class="header__actions">
        <a
          href="https://github.com/farengeyt451/seenit-episode-tracker"
          target="_blank"
          rel="noopener noreferrer"
          class="header__link"
          aria-label="GitHub"
        >
          <GitHubIcon />
        </a>
        <ThemeToggle />
      </div>
    </header>

    <main class="main">
      <section class="hero">
        <h1 class="hero__title">Your personal series companion</h1>
        <p class="hero__description">
          Mark what you've watched, pick up where you left off. Free browser extension for Chrome and Firefox.
        </p>
        <div class="hero__wrapper">
          <a
            href="https://chromewebstore.google.com/detail/seenit-episode-tracker/amopmnmnaimidbcfnjbnlfagmlmdhlch"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            >Add to Chrome</a
          >
          <a
            href="https://addons.mozilla.org/ru/firefox/addon/seenit-episode-tracker/"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            >Add to Firefox</a
          >
        </div>
      </section>

      <section class="preview">
        <div class="preview__container">
          <Image
            src={heroImage}
            alt="Seenit! Extension Preview"
            class="preview__image"
            loading="eager"
          />
        </div>
      </section>

      <section class="features">
        <h2 class="features__title">Why Choose Seenit?</h2>
        <div class="features__grid">
          <div class="feature">
            <h3 class="feature__title">Track Episodes Easily</h3>
            <p class="feature__description">
              Click to mark an episode as watched. Seenit saves your progress for each show, so you can pick up right
              where you left off.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">Works Offline</h3>
            <p class="feature__description">
              All data stays in your browser. Nothing is sent to external servers - your watch history is private and
              always available.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">Clean Interface</h3>
            <p class="feature__description">
              Simple design, fast performance. Find your shows quickly and get back to watching without distractions.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">Chrome and Firefox</h3>
            <p class="feature__description">
              Install on your preferred browser. Both versions are kept up to date and work the same way.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">No Account Required</h3>
            <p class="feature__description">
              No signup, no email, no password. Install it and start using it immediately.
            </p>
          </div>
          <div class="feature">
            <h3 class="feature__title">No Ads or Tracking</h3>
            <p class="feature__description">Zero ads. Zero analytics. We don't collect data or track what you watch.</p>
          </div>
        </div>
      </section>

      <section class="how-it-works">
        <h2 class="how-it-works__title">How It Works</h2>
        <p class="how-it-works__description">
          Install the extension, click the Seenit icon <img
            src="/icon.png"
            alt="Seenit icon"
            class="inline-icon"
            loading="lazy"
          /> in your toolbar, and add the TV series you're watching. Mark episodes as you go - your progress is saved automatically.
        </p>
      </section>
    </main>

    <footer class="footer">
      <p class="footer__copyright">©Seenit! - {currentYear}</p>
    </footer>
  </div>
</Layout>
