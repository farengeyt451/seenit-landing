---
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.png';

const currentYear = new Date().getFullYear();
---

<Layout>
  <div class="page">
    <header class="header">
      <div class="logo">
        <span class="logo__text">Seenit!</span>
      </div>
      <div class="header__actions">
        <a
          href="https://github.com/farengeyt451/seenit-episode-tracker"
          target="_blank"
          rel="noopener noreferrer"
          class="header__link"
          aria-label="GitHub"
        >
          <GitHubIcon />
        </a>
        <ThemeToggle />
      </div>
    </header>

    <main class="main">
      <section class="hero">
        <h1 class="hero__title">Track your favorite series effortlessly</h1>
        <p class="hero__description">Your personal series companion that lives in your browser</p>
        <div class="hero__wrapper">
          <a
            href="https://chromewebstore.google.com/detail/seenit-episode-tracker/amopmnmnaimidbcfnjbnlfagmlmdhlch"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            >Add to Chrome</a
          >
          <a
            href="https://addons.mozilla.org/ru/firefox/addon/seenit-episode-tracker/"
            target="_blank"
            rel="noopener noreferrer"
            class="button button--primary"
            >Add to Firefox</a
          >
        </div>
      </section>

      <section class="preview">
        <div class="preview__container">
          <Image
            src={heroImage}
            alt="Seenit! Extension Preview"
            class="preview__image"
          />
        </div>
      </section>
    </main>

    <footer class="footer">
      <p class="footer__copyright">©Seenit! - {currentYear}</p>
    </footer>
  </div>
</Layout>
